APP_ENV=local
DATABASE_PATH=./database/database.sqlite

# AI interpretation provider (SPEC-008/011). Leave unset (or "mock") to use the
# deterministic, no-key-required MockInterpretationProvider — the default, and safe for local
# development or a fresh checkout.
#
# To use a real Gemini-backed interpretation instead:
#   1. Get an API key from https://aistudio.google.com/ (or your Google Cloud project).
#   2. Set AI_PROVIDER=gemini and AI_API_KEY below.
#   3. Optionally set AI_MODEL — check https://ai.google.dev/gemini-api/docs/models for the
#      current model list; the default here may be outdated by the time you read this
#      (Gemini model availability changes on a timescale of months).
#   Never commit a real key. This file is the template — only .env (gitignored) holds secrets.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gemini-3.6-flash

# Rate limiting for POST /api/interpretations/{id} (SPEC-012) — the one endpoint with real
# external cost once AI_PROVIDER=gemini. Applies regardless of provider. Defaults shown below;
# set AI_RATE_LIMIT_MAX=0 to reject every request (a way to fully disable the endpoint without
# removing the route).
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_SECONDS=3600
