{
  "name": "yijing/core",
  "description": "Framework-free I Ching domain model: trigrams, hexagrams, lines, casting, relations.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.3"
  },
  "autoload": {
    "psr-4": {
      "Yijing\\Core\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Yijing\\Core\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit"
  }
}
